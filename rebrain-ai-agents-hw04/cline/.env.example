# ---------------------------------------------------------------------------
# Прокси (закомментировано — по умолчанию прокси НЕ используется).
# Раскомментируйте и подставьте корпоративные значения, если потребуется.
# Обращения к корпоративному Nexus (vs-nexus02.brg.loc) и внутренним
# сервисам compose (redis, postgres, monitor, worker) должны идти мимо прокси.
# ---------------------------------------------------------------------------
# HTTP_PROXY=http://vs-proxy-gsa01.brg.loc:3128
# HTTPS_PROXY=http://vs-proxy-gsa01.brg.loc:3128
# NO_PROXY=localhost,127.0.0.1,::1,brg.loc,.brg.loc,redis,postgres,monitor,worker,vs-nexus02.brg.loc
# UV_INDEX_URL=http://vs-nexus02.brg.loc:8081/repository/pypi-proxy/simple

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_STREAM=news:stream
REDIS_GROUP=news-workers
REDIS_CONSUMER=worker-1
REDIS_SEEN_KEY=news:seen_links

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=news
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Monitor
POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15
SPACY_MODEL=ru_core_news_sm

# RSS feeds (JSON: "Агентство": "URL"). Минимум 3 российских агентства.
RSS_FEEDS={"РИА Новости": "https://ria.ru/export/rss2/archive/index.xml", "ТАСС": "https://tass.ru/rss/v2.xml", "Коммерсантъ": "https://www.kommersant.ru/RSS/news.xml"}
# User-Agent браузера при запросе к RSS-лентам (не хардкодится в коде).
RSS_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Logging
LOG_LEVEL=INFO