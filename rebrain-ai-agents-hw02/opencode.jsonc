{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",
  "username": "VP",
  "instructions": [
    "AGENTS.md"
  ],
  "shell": "/bin/bash",
  "default_agent": "plan",
  "formatter": true,
  "websearch": {
    "provider": "random",
  },
  // https://opencode.ai/docs/permissions
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "secret*/*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "deny"
    },
  ],
  "agents": {
    "plan": {
      "mode": "primary",
      "permissions": [
        {
          "action": "shell",
          "resource": "git push *",
          "effect": "deny",
        },
      ],
    },
    "build": {
      "mode": "primary",
      "permissions": [
        {
          "action": "shell",
          "resource": "git push *",
          "effect": "ask",
        },
      ],
    }
  },
  "providers": {
    "ollama": {
      "name": "Ollama local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
        // "apiKey": "{env:OLLAMA_API_KEY}",
        // "apiKey": "ollama"
      },
      "models": {
        "qwen3.6:27b-q4_K_M": {
          "name": "qwen3.6:27b-q4_K_M"
        },
      },
    },
  },
}