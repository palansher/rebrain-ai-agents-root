# Base URL of the Open-Meteo API (no trailing slash)
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Timeout in seconds for requests to Open-Meteo
REQUEST_TIMEOUT=10

# Timezone forwarded to the forecast endpoint ("auto" or an IANA name)
TIMEZONE=auto

# Host and port used by `uv run weather-proxy`
HOST=127.0.0.1
PORT=8010